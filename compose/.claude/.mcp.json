{
  "mcpServers": {
    "qdrant_remote": {
      "type": "http",
      "url": "http://mcp-qdrant:8000/mcp"
    },
    "qdrant_local": {
      "type": "stdio",
      "command": "uvx",
      "args": ["mcp-server-qdrant"],
      "env": {
        "QDRANT_URL": "${QDRANT_URL}",
        "COLLECTION_NAME": "${QDRANT_INDEX}",
        "EMBEDDING_MODEL": "sentence-transformers/all-MiniLM-L6-v2"
      }
    }
  }
}
