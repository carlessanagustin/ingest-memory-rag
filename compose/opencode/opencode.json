{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://ollama:11434/v1"
      },
      "models": {
        "qwen3.5:9b": {
          "name": "qwen3.5:9b"
        },
        "nemotron-3-nano:4b": {
          "name": "nemotron-3-nano:4b"
        },
        "qwen3:8b": {
          "name": "qwen3:8b"
        }
      }
    }
  },
  "mcp": {
    "qdrant_remote": {
      "enabled": true,
      "type": "remote",
      "url": "http://mcp-qdrant:8000/mcp"
    },
    "qdrant_local": {
      "enabled": false,
      "type": "local",
      "command": [
        "uvx",
        "mcp-server-qdrant"
      ],
      "environment": {
        "QDRANT_URL": "{env:QDRANT_URL}",
        "COLLECTION_NAME": "{env:QDRANT_INDEX}"
      }
    }
  },
  "default_agent": "qdrant_only",
  "agent": {
    "qdrant_only": {
      "description": "Answers strictly from the internal knowledge base",
      "mode": "primary",
      "temperature": 0,
      "steps": 6,
      "prompt": "You have exactly one source of truth: the qdrant_* tools. You must answer questions strictly based on the information available in the qdrant_* tools. If the answer is not found in the qdrant_* tools, respond with 'I don't know.' Do not provide any information that is not present in the qdrant_* tools.",
      "permission": {
        "qdrant_remote_*": "allow",
        "qdrant_local_*": "deny",
        "read": "deny",
        "edit": "deny",
        "glob": "deny",
        "grep": "deny",
        "list": "deny",
        "bash": "deny",
        "webfetch": "deny",
        "websearch": "deny",
        "task": "deny",
        "lsp": "deny",
        "skill": "deny",
        "todowrite": "deny",
        "external_directory": "deny"
      }
    }
  }
}