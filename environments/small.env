# Resource sizing profile: small (tight VPS). No secrets — safe to commit.
#
# Loaded by the Makefile via `docker compose --env-file environments/small.env
# --env-file .env` when DEPLOY_ENV=small. Feeds the ${VAR:-default}
# interpolation in compose/*.yaml. Tune to fit the target VPS.
APP_CPU_LIMIT=1
APP_MEM_LIMIT=768M
APP_CPU_RES=0.25
APP_MEM_RES=256M

QDRANT_CPU_LIMIT=1
QDRANT_MEM_LIMIT=1G
QDRANT_CPU_RES=0.25
QDRANT_MEM_RES=256M

MCP_QDRANT_CPU_LIMIT=1
MCP_QDRANT_MEM_LIMIT=768M
MCP_QDRANT_CPU_RES=0.25
MCP_QDRANT_MEM_RES=256M

OLLAMA_CPU_LIMIT=4
OLLAMA_MEM_LIMIT=8G
OLLAMA_CPU_RES=0.5
OLLAMA_MEM_RES=1G

OPENCODE_CPU_LIMIT=1
OPENCODE_MEM_LIMIT=1G
OPENCODE_CPU_RES=0.25
OPENCODE_MEM_RES=256M
