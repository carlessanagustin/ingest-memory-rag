# Resource sizing profile: large (beefy VPS). No secrets — safe to commit.
#
# Loaded by the Makefile via `docker compose --env-file environments/large.env
# --env-file .env` when DEPLOY_ENV=large. Feeds the ${VAR:-default}
# interpolation in compose/*.yaml. Tune to fit the target VPS — in particular
# size OLLAMA_MEM_LIMIT to the largest model you serve.
APP_CPU_LIMIT=4
APP_MEM_LIMIT=3G
APP_CPU_RES=1
APP_MEM_RES=1G

QDRANT_CPU_LIMIT=4
QDRANT_MEM_LIMIT=6G
QDRANT_CPU_RES=1
QDRANT_MEM_RES=1G

MCP_QDRANT_CPU_LIMIT=4
MCP_QDRANT_MEM_LIMIT=3G
MCP_QDRANT_CPU_RES=1
MCP_QDRANT_MEM_RES=1G

OLLAMA_CPU_LIMIT=12
OLLAMA_MEM_LIMIT=48G
OLLAMA_CPU_RES=2
OLLAMA_MEM_RES=4G

OPENCODE_CPU_LIMIT=4
OPENCODE_MEM_LIMIT=4G
OPENCODE_CPU_RES=1
OPENCODE_MEM_RES=1G
