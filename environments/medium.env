# Resource sizing profile: medium (default). No secrets — safe to commit.
#
# Loaded by the Makefile via `docker compose --env-file environments/medium.env
# --env-file .env` when DEPLOY_ENV=medium. These variables feed the
# ${VAR:-default} interpolation in compose/*.yaml; the inline defaults there
# already equal medium, so this file simply makes the tier explicit.
APP_CPU_LIMIT=2
APP_MEM_LIMIT=1.5G
APP_CPU_RES=0.5
APP_MEM_RES=512M

QDRANT_CPU_LIMIT=2
QDRANT_MEM_LIMIT=2G
QDRANT_CPU_RES=0.5
QDRANT_MEM_RES=512M

MCP_QDRANT_CPU_LIMIT=2
MCP_QDRANT_MEM_LIMIT=1.5G
MCP_QDRANT_CPU_RES=0.5
MCP_QDRANT_MEM_RES=512M

OLLAMA_CPU_LIMIT=6
OLLAMA_MEM_LIMIT=24G
OLLAMA_CPU_RES=1
OLLAMA_MEM_RES=2G

OPENCODE_CPU_LIMIT=2
OPENCODE_MEM_LIMIT=2G
OPENCODE_CPU_RES=0.5
OPENCODE_MEM_RES=512M
