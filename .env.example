# Copy to .env and adjust. Values are read from the environment at startup.
# Secrets (if any, e.g. QDRANT_API_KEY) must come from the environment — never commit them.

WATCH_FOLDER=./raw
QDRANT_URL=http://localhost:6333
QDRANT_INDEX=Document

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

SPLIT_BY=word
SPLIT_LENGTH=200
SPLIT_OVERLAP=30

DEBOUNCE_SECONDS=1.0
SCAN_ON_START=true
QDRANT_RECREATE_INDEX=false

# Use a polling watcher instead of native FS events. Required when watching a
# bind-mounted host folder from inside a container on Docker Desktop.
WATCH_USE_POLLING=false

# --- LobeChat (docker compose `lobe-chat` service) -------------------------
# All optional. Leave blank to configure providers in the LobeChat UI instead.
# Password-protect the LobeChat instance (blank = no gate).
LOBE_ACCESS_CODE=
# OpenAI-compatible provider.
OPENAI_API_KEY=
OPENAI_PROXY_URL=
# Anthropic provider.
ANTHROPIC_API_KEY=
