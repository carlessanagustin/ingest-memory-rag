DEPLOY_ENV=medium

WATCH_FOLDER=./raw
WATCH_IGNORE=.watchignore
WATCH_REMOVE=false
WATCH_USE_POLLING=false
# GID the app container runs as. Set to `id -g` on the host so it matches the
# group owning ./raw — required for WATCH_REMOVE to be able to delete files.
PGID=10001

QDRANT_URL=http://localhost:6333
QDRANT_INDEX=Document

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

SPLIT_BY=word
SPLIT_LENGTH=200
SPLIT_OVERLAP=30

DEBOUNCE_SECONDS=1.0
SCAN_ON_START=true
QDRANT_RECREATE_INDEX=false

LOBE_ACCESS_CODE=
# OpenAI-compatible provider.
OPENAI_API_KEY=
OPENAI_PROXY_URL=
# Anthropic provider.
ANTHROPIC_API_KEY=

# OpenCode CLI
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=