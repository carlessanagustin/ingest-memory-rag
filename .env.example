# Copy to .env and adjust. Values are read from the environment at startup.
# Secrets (if any, e.g. QDRANT_API_KEY) must come from the environment — never commit them.

WATCH_FOLDER=./raw
QDRANT_URL=http://localhost:6333
QDRANT_INDEX=Document

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

SPLIT_BY=word
SPLIT_LENGTH=200
SPLIT_OVERLAP=30

DEBOUNCE_SECONDS=1.0
SCAN_ON_START=true
QDRANT_RECREATE_INDEX=false
